parameters:
	ignoreErrors:
		-
			message: '#^Match arm comparison between BenRowe\\StateFlow\\Locking\\LockStrategy\:\:WAIT and BenRowe\\StateFlow\\Locking\\LockStrategy\:\:WAIT is always true\.$#'
			identifier: match.alwaysTrue
			count: 1
			path: src/Locking/LockManager.php

		-
			message: '#^Parameter \#1 \$decoded of method BenRowe\\StateFlow\\TransitionContextSerializer\:\:restoreActionExecutionsCollection\(\) expects array\<string, mixed\>, array given\.$#'
			identifier: argument.type
			count: 1
			path: src/TransitionContextSerializer.php

		-
			message: '#^Parameter \#1 \$decoded of method BenRowe\\StateFlow\\TransitionContextSerializer\:\:restoreActionSkipsCollection\(\) expects array\<string, mixed\>, array given\.$#'
			identifier: argument.type
			count: 1
			path: src/TransitionContextSerializer.php

		-
			message: '#^Parameter \#1 \$decoded of method BenRowe\\StateFlow\\TransitionContextSerializer\:\:restoreConfiguration\(\) expects array\<string, mixed\>, array given\.$#'
			identifier: argument.type
			count: 1
			path: src/TransitionContextSerializer.php

		-
			message: '#^Parameter \#1 \$decoded of method BenRowe\\StateFlow\\TransitionContextSerializer\:\:restoreGateEvaluationsCollection\(\) expects array\<string, mixed\>, array given\.$#'
			identifier: argument.type
			count: 1
			path: src/TransitionContextSerializer.php

		-
			message: '#^Parameter \#2 \$decoded of method BenRowe\\StateFlow\\TransitionContextSerializer\:\:restoreExecutionStatus\(\) expects array\<string, mixed\>, array given\.$#'
			identifier: argument.type
			count: 1
			path: src/TransitionContextSerializer.php

		-
			message: '#^Binary operation "\+" between mixed and 1 results in an error\.$#'
			identifier: binaryOp.invalid
			count: 1
			path: tests/Integration/StateFlow/ExecutionControlTest.php

		-
			message: '#^Property BenRowe\\StateFlow\\Action\\Action@anonymous/tests/Integration/StateFlow/ExecutionControlTest\.php\:123\:\:\$stateCaptures is never read, only written\.$#'
			identifier: property.onlyWritten
			count: 1
			path: tests/Integration/StateFlow/ExecutionControlTest.php

		-
			message: '#^Property BenRowe\\StateFlow\\Action\\Action@anonymous/tests/Integration/StateFlow/ExecutionControlTest\.php\:152\:\:\$stateCaptures is never read, only written\.$#'
			identifier: property.onlyWritten
			count: 1
			path: tests/Integration/StateFlow/ExecutionControlTest.php

		-
			message: '#^Property BenRowe\\StateFlow\\Action\\Action@anonymous/tests/Integration/StateFlow/ExecutionControlTest\.php\:181\:\:\$stateCaptures is never read, only written\.$#'
			identifier: property.onlyWritten
			count: 1
			path: tests/Integration/StateFlow/ExecutionControlTest.php

		-
			message: '#^Cannot access offset ''version'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: tests/Integration/StateFlow/WorkflowResumeTest.php

		-
			message: '#^Cannot call method toArray\(\) on mixed\.$#'
			identifier: method.nonObject
			count: 1
			path: tests/Integration/StateFlow/WorkflowResumeTest.php
