{
    "name": "covergenius/stateflow",
    "description": "A flexible state machine library for PHP",
    "type": "library",
    "keywords": ["state-machine", "workflow", "state", "transition"],
    "license": "MIT",
    "authors": [
        {
            "name": "Ben Rowe",
            "email": "ben.rowe@covergenius.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "doctrine/collections": "^2.4"
    },
    "require-dev": {
        "brianium/paratest": "^7.4",
        "esi/phpunit-coverage-check": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpmd/phpmd": "^2.15",
        "phpstan/phpstan": "^1.10 || ^2.0",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "CoverGenius\\StateFlow\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoverGenius\\StateFlow\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "paratest --no-coverage",
        "test:single": "phpunit --no-coverage",
        "test:coverage": "phpunit --coverage-text --only-summary-for-coverage-text",
        "test:coverage:detail": "phpunit --coverage-text",
        "test:coverage:ci": [
            "phpunit --coverage-clover clover.xml --coverage-text",
            "coverage-check clover.xml 100"
        ],
        "quality": [
            "phpmd src text phpmd.xml.dist",
            "@phpstan"
        ],
        "phpstan": "phpstan analyse --memory-limit=1G",
        "phpstan:baseline": "phpstan analyse --generate-baseline --memory-limit=1G",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "lint:fix": "php-cs-fixer fix",
        "check": "scripts/check.sh"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
